# Pusher設定（https://pusher.com で無料アカウントを作成して取得）
NEXT_PUBLIC_PUSHER_APP_KEY=your_pusher_app_key_here
NEXT_PUBLIC_PUSHER_CLUSTER=ap3
PUSHER_APP_ID=your_pusher_app_id_here
PUSHER_SECRET=your_pusher_secret_here

# Supabase設定（ルーム永続化 — v2 で追加）
# Supabase ダッシュボード > Settings > API から取得
# ⚠️ SERVICE_ROLE_KEY はサーバー専用。NEXT_PUBLIC_ を絶対に付けないこと
SUPABASE_URL=https://yytxgxlhgotscwztlsqj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 適用手順:
# 1. migrations/20260710_grammar_rooms.sql を Supabase SQL Editor で実行
# 2. Vercel の環境変数に SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY を追加
# 3. 再デプロイ
